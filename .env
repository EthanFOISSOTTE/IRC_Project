# Configuration du serveur
PORT=3000                 # Port sur lequel le serveur écoute
HOST=localhost            # Hôte du serveur

# MongoDB
MONGO_URI=mongodb+srv://webserv:webserv@irs-serveur.r5zte.mongodb.net/?retryWrites=true&w=majority&appName=IRS-Serveur # URL de connexion MongoDB
MONGO_USER=               # Optionnel : nom d'utilisateur pour MongoDB (si configuré)
MONGO_PASSWORD=           # Optionnel : mot de passe pour MongoDB (si configuré)

# Authentification
JWT_SECRET=supersecretkey   # Clé secrète pour signer les JWT
JWT_EXPIRES_IN=1d           # Durée de validité des tokens JWT (exemple : 1d, 12h)

# Socket.io
SOCKET_ORIGIN=http://localhost:3000  # Origine autorisée pour les connexions Socket.io (CORS)

# Sécurité
NODE_ENV=development        # Mode de l'application (development, production)
